//============================================================================
//Rule : AD - ACL - GenericAll/DACL Grant on Container Object
//MITRE : T1222 (File and Directory Permissions Modification)
//Data Source : SecurityEvent , EventID : 5136
//Prerequisite : DC 啟用 "Audit Directory Service Changes (Success)"，並對 OU/容器物件設 SACL
//Type : 偵測對 OU/容器/GPO 物件的安全性描述元（nTSecurityDescriptor）變更——GenericAll 持久化
//Severity : HIGH - 對容器物件授予過度權限是隱蔽持久化與提權前置
//Known FP : 合法權限委派；應由已授權管理帳號執行（可白名單）
//Tuning : 聚焦 OU/GPO/container 類別；非授權帳號變更即升級
//Note : 本 lab 中 labadmin 在 DC01 本機執行 Set-Acl 觸發 5136（Sentinel 已驗證），
//       impacket-dacledit 遠端寫入不觸發 5136（LDAP channel 問題）；
//       DC 本機操作的 ObjectDN 為 DC=corp,DC=lab（網域根），非 OU=Employees
//============================================================================
SecurityEvent
| where EventID == 5136
| extend AttrName = extract(@'<Data Name="AttributeLDAPDisplayName">([^<]+)</Data>', 1, tostring(EventData))
| extend SubjectUser = extract(@'<Data Name="SubjectUserName">([^<]+)</Data>', 1, tostring(EventData))
| extend ObjectDN = extract(@'<Data Name="ObjectDN">([^<]+)</Data>', 1, tostring(EventData))
| extend ObjectClass = extract(@'<Data Name="ObjectClass">([^<]+)</Data>', 1, tostring(EventData))
| where AttrName == "nTSecurityDescriptor"
| where SubjectUser !endswith "$"
| project TimeGenerated, SubjectUser, AttrName, ObjectDN, ObjectClass, Computer
| order by TimeGenerated desc
