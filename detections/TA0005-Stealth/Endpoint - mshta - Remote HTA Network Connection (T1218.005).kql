//============================================================================
//Rule : Endpoint - mshta - Remote HTA Network Connection
//MITRE : T1218.005 (System Binary Proxy Execution: Mshta)
//Data Source : DeviceNetworkEvents (MDE)
//Prerequisite : MDE onboarded, DeviceNetworkEvents connector enabled in Sentinel
//Type : 偵測 mshta.exe 對外部 IP 建立網路連線（LOLBin 載入遠端 HTA）
//Severity : HIGH - mshta 連到非企業 IP 為異常行為
//Known FP : 企業內部合法 HTA 應用程式（極少見）
//Tuning : 排除已知合法內部 URL；關聯父程序確認攻擊鏈
//Note : 本 lab 中透過 Sliver C2 執行 mshta.exe 載入遠端 HTA（verify.hta），
//       偵測訊號已驗證
//============================================================================
DeviceNetworkEvents
| where InitiatingProcessFileName =~ "mshta.exe"
| where RemoteIPType != "Private"
| project
    TimeGenerated,
    DeviceName,
    InitiatingProcessAccountName,
    RemoteIP,
    RemotePort,
    RemoteUrl,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine
| sort by TimeGenerated desc
