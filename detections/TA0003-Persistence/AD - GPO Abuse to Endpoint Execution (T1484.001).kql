//============================================================================
//Rule : AD - GPO Abuse to Endpoint Execution (Cross-Source Correlation, Path B)
//MITRE : T1484.001 (Group Policy Modification)
//Data Source : DeviceFileEvents (MDE) + DeviceProcessEvents (MDE)
//Prerequisite : DC01 已 MDE onboard；受影響端點已 MDE onboard
//Type : 關聯 GPO SYSVOL 寫入（路徑B）與受影響端點的下游程序執行——證明 GPO 濫用實際生效
//Severity : CRITICAL - GPO 變更導致端點執行是完整攻擊生效的鐵證
//Known FP : 合法 GPO 部署腳本；以授權管理帳號與已知部署基線排除
//Tuning : 調整關聯時間窗（6h）；GPO 套用到端點執行可能有延遲
//Note : 概念設計；本 lab Windows 11 端點不觸發 GPO Preferences CSE
//       SYSVOL 寫入成功但下游執行未觸發，右表（DeviceProcessEvents）無資料
//       左表改為 DeviceFileEvents（路徑B），join key 改為 DeviceName 避免時間戳精確比對問題
//       原規則 join key 為時間戳精確相等（幾乎不可能），已修正為 DeviceName + between 時間窗
//============================================================================
let GPOChanges = DeviceFileEvents
    | where DeviceName has "DC01"
    | where FolderPath has "SYSVOL"
    | where FolderPath has "Policies"
    | where FileName in ("ScheduledTasks.xml", "scripts.ini", "GPT.INI")
    | where ActionType in ("FileCreated", "FileModified")
    | where InitiatingProcessFileName !in~ ("svchost.exe", "dfsr.exe", "dfsrs.exe")
    | where TimeGenerated > ago(6h)
    | project GPOTime=Timestamp, FileName, DCName=DeviceName;
GPOChanges
| join kind=inner (
    DeviceProcessEvents
    | where TimeGenerated > ago(6h)
    | where InitiatingProcessFileName in~ ("gpscript.exe", "cmd.exe", "powershell.exe")
    | where ProcessCommandLine has_any ("startup", "scheduledtask", "test.bat")
    | project ExecTime=Timestamp, ExecDevice=DeviceName, ProcessCommandLine
) on $left.DCName == $right.ExecDevice
| where ExecTime between (GPOTime .. (GPOTime + 6h))
| project GPOTime, FileName, ExecTime, ExecDevice, ProcessCommandLine
| order by GPOTime desc
