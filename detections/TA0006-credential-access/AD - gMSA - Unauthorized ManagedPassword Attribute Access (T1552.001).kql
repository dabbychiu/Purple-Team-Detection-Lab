//============================================================================
//Rule : AD - gMSA - Unauthorized ManagedPassword Attribute Access
//MITRE : T1552.001 (Credentials in Files / AD attributes)
//Data Source : SecurityEvent , EventID : 4662
//Prerequisite : gMSA 物件的 msDS-ManagedPassword 屬性設定讀取 SACL（Everyone ReadProperty Success）
//Type : 偵測非授權帳號讀取 gMSA 密碼屬性——直接取得服務帳號憑證的替代路徑
//Severity : CRITICAL - gMSA 密碼讀取等同取得服務帳號完整控制
//Known FP : PrincipalsAllowedToRetrieveManagedPassword 內的授權帳號/電腦
//Tuning : 建立授權讀取帳號白名單；任何非白名單帳號讀取即高可信告警
//Note : 本 lab 中 CORP\Alice 以 netexec --gmsa 嘗試讀取，被拒（no read permissions），
//       DC01 產生 4662，Subject=alice，AccessMask=0x10，35 筆事件；偵測訊號已驗證
//       此規則為 Stage 4a LSASS 被 MDE 攔截後的替代偵測路徑
//============================================================================
SecurityEvent
| where EventID == 4662
| where ObjectServer == "DS"
| where Properties has "msds-managedpassword"
| where SubjectUserName !endswith "$"
| where SubjectUserName != "-"
| project TimeGenerated, SubjectAccount, Computer, ObjectName, Properties
| order by TimeGenerated desc
