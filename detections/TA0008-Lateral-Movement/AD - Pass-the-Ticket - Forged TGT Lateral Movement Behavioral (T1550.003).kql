//============================================================================
//Rule : AD - Pass-the-Ticket - Forged TGT Lateral Movement Behavioral
//MITRE : T1550.003 (Use Alternate Authentication Material: Pass the Ticket)
//Data Source : SecurityEvent , EventID : 4624
//Prerequisite : 目標主機（SRV-FILE 等高價值主機）納入 Sentinel 日誌收集，AMA 已安裝
//Type : 偵測同帳號同來源 IP 在短時間內對多台主機做 Kerberos 登入——票證橫向移動的行為指紋
//Severity : HIGH - 正常使用者不會在短時間內用相同 IP 對多台主機做 Kerberos 登入
//Known FP : IT 管理員批次遠端管理（runas 跨帳號、自動化部署）
//           合法服務帳號做服務巡檢（SCOM/監控代理）
//Tuning : 建立已知管理員來源 IP 白名單；縮短 bin 時間窗提高精度
//         TargetHostCount 門檻依環境調整；小環境 >=2 即可，大環境建議 >=3
//Alert Rule : 建議排程 30 分鐘，與 bin(TimeGenerated, 30m) 對齊
//Note : 本 lab 以 Silver Ticket 存取 SRV-FILE C$/FinanceShare/HRShare（cifs SPN）
//       SRV-FILE 4624（LogonType=3, Kerberos, SrcIp=10.0.5.4）有，DC 4769 無
//       Stage 6d 偵測邏輯：同帳號同 IP 短時間打多台主機
//       Lab 環境只有一台 SRV-FILE，TargetHostCount 無法 >=2，規則未驗證
//       概念設計：適用於有多台高價值主機的企業環境
//       搭配 AD - Kerberos - Silver Ticket Service Access Without DC Log 使用效果更佳
//============================================================================
SecurityEvent
| where EventID == 4624
| where LogonType == 3
| where AuthenticationPackageName == "Kerberos"
| where TargetUserName !endswith "$"
| where TargetUserName != "ANONYMOUS LOGON"
| where IpAddress !startswith "127."
| where IpAddress != "-"
| summarize
    TargetHostCount = dcount(Computer),
    TargetHosts = make_set(Computer, 20),
    LogonCount = count()
    by TargetUserName, IpAddress, bin(TimeGenerated, 30m)
| where TargetHostCount >= 2
| project TimeGenerated, TargetUserName, IpAddress, TargetHostCount, TargetHosts, LogonCount
| order by TargetHostCount desc
