//============================================================================
//Rule : AD - KDC - AS-REP Roasting Bulk Harvesting (Behavioral Layer)
//MITRE : T1558.004 (AS-REP Roasting)
//Data Source : SecurityEvent , EventID : 4768
//Prerequisite : 同上
//Type : 偵測單一來源短時間內對多個無預先驗證帳號索取 TGT——批次 AS-REP 收割
//Severity : HIGH - 批次行為幾乎排除設定疏失的可能，高度確認為攻擊
//Known FP : 幾乎無；正常運作不會短時間對多個關閉預先驗證的帳號集中請求
//Tuning : 依環境調整 bin 與門檻；同一來源 IP 命中多個 TargetUser 是關鍵訊號
//Note : PreAuthType/TargetUserName/IpAddress 自 EventData XML 以 extract() 取值；
//       本 lab 3 個 svc-legacy 帳號，TargetedAccounts=3，偵測訊號已驗證
//============================================================================
SecurityEvent
| where EventID == 4768
| extend PreAuthType = extract(@'Name="PreAuthType">([^<]+)<', 1, EventData)
| extend TargetUser = extract(@'Name="TargetUserName">([^<]+)<', 1, EventData)
| extend SrcIp = extract(@'Name="IpAddress">([^<]+)<', 1, EventData)
| where PreAuthType == "0"
| where TargetUser !endswith "$"
| summarize
    TargetedAccounts = dcount(TargetUser),
    AccountSet = make_set(TargetUser, 20),
    RequestCount = count()
    by SrcIp, Computer, bin(TimeGenerated, 10m)
| where TargetedAccounts >= 2
| order by TargetedAccounts desc
