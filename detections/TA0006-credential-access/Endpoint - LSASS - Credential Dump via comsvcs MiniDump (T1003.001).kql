//============================================================================
//Rule : Endpoint - LSASS - Credential Dump via comsvcs MiniDump (LOLBAS)
//MITRE : T1003.001 (LSASS Memory)
//Data Source : DeviceProcessEvents (MDE)
//Prerequisite : EMPLOYEE01 已 MDE onboard
//Type : 偵測 rundll32 呼叫 comsvcs.dll MiniDump——經典 LOLBAS LSASS 傾印手法
//Severity : HIGH - comsvcs MiniDump 幾乎專用於憑證傾印，誤報極低
//Known FP : 極少；合法診斷極罕見使用此路徑
//Tuning : 可加入輸出 .dmp 檔案落地事件（DeviceFileEvents）關聯提高信心
//Note : 概念設計；本 lab 執行此命令被 MDE 以 HackTool:Win32/DumpLsass.H 直接阻擋，
//       代表 MDE 在工具簽章層有效攔截；此規則適用於 MDE 未阻擋的環境作為補充偵測
//============================================================================
DeviceProcessEvents
| where FileName =~ "rundll32.exe"
| where ProcessCommandLine has "comsvcs" and ProcessCommandLine has_any ("MiniDump", "#24")
| project
    Timestamp,
    DeviceName,
    ProcessCommandLine,
    InitiatingProcessAccountName,
    InitiatingProcessFileName
| order by Timestamp desc
