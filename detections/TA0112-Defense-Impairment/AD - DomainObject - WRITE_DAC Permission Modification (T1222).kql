//============================================================================
//Rule : AD - DomainObject - Directory Replication by Non-DC Account
//MITRE : T1003.006 (OS Credential Dumping: DCSync)
//Data Source : SecurityEvent , EventID : 4662
//Prerequisite : 啟用 "Audit Directory Service Access (Success)"
//Type : 偵測非 DC 帳號使用 Replicating Directory Changes 權限（DCSync 特徵）
//Severity : CRITICAL - DCSync 可取得全域 NTLM hash
//Known FP : 合法 AD 複寫（DC 機器帳號）
//Tuning : 排除 DC 機器帳號（SubjectUserName endswith "$"）
//============================================================================
SecurityEvent 
| where EventID == 4662 
| where TimeGenerated > ago(2h) 
| where ObjectServer == "DS" 
| where AccessMask == "0x40000" 
| where SubjectUserName !endswith "$" 
| project TimeGenerated, SubjectAccount, Computer, ObjectServer, ObjectName, ObjectType, AccessMask, Properties 
| order by TimeGenerated desc
