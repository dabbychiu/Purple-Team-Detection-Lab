//============================================================================
//Rule : AD - DomainObject - WRITE_DAC Permission Modification
//MITRE : T1222 (File and Directory Permissions Modification)
//Data Source : SecurityEvent , EventID : 4662
//Prerequisite : 啟用 "Audit Directory Service Access (Success)"，並於目標物件設定 SACL
//Type : 偵測非機器帳號對 AD 物件寫入 DACL (WRITE_DAC, AccessMask 0x40000) — 提權至 DCSync 的前置步驟
//Severity : HIGH - 修改網域物件 ACL，常為 DCSync / 域管提權前置動作
//Known FP : 合法權限委派 / AD 管理操作 / Azure AD Connect (應以 allowlist 排除)
//Tuning : 建立已授權帳號白名單；ObjectName 為網域根物件時視為 CRITICAL
//============================================================================
SecurityEvent 
| where EventID == 4662 
| where ObjectServer == "DS" 
| where AccessMask == "0x40000" 
| where SubjectUserName !endswith "$" 
| project TimeGenerated, SubjectAccount, Computer, ObjectServer, ObjectName, ObjectType, AccessMask, Properties 
| order by TimeGenerated desc
